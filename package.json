{
  "name": "musinsa-pricewagon-nextjs-react-ts-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "next start",
    "prod": "env-cmd -f .env.production pnpm codegen:prod && next dev",
    "dev": "env-cmd -f .env.development pnpm codegen:dev && next dev",
    "local": "env-cmd -f .env.local pnpm codegen:local && next dev",
    "prod-without-codegen": "env-cmd -f .env.production next dev",
    "dev-without-codegen": "env-cmd -f .env.development next dev",
    "local-without-codegen": "env-cmd -f .env.local next dev",
    "build:dev": "env-cmd -f .env.development next build",
    "build:prod": "env-cmd -f .env.production next build",
    "build:local": "env-cmd -f .env.local next build",
    "codegen:dev": "openapi-generator-cli generate -i https://devapi.ilsang.co.kr/api-docs -g typescript-axios --skip-validate-spec --additional-properties withSeparateModelsAndApi=true,apiPackage=api,modelPackage=model -o ./src/apis/main && rm src/apis/main/.gitignore",
    "codegen:prod": "openapi-generator-cli generate -i https://devapi.ilsang.co.kr/api-docs -g typescript-axios --skip-validate-spec --additional-properties withSeparateModelsAndApi=true,apiPackage=api,modelPackage=model -o ./src/apis/main && rm src/apis/main/.gitignore",
    "codegen:local": "openapi-generator-cli generate -i https://devapi.ilsang.co.kr/api-docs -g typescript-axios --skip-validate-spec --additional-properties withSeparateModelsAndApi=true,apiPackage=api,modelPackage=model -o ./src/apis/main && rm src/apis/main/.gitignore",
    "lint": "next lint",
    "prettier": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "fix:lint": "next lint --fix",
    "fix:prettier": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky install",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.7",
    "next": "15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4",
    "@eslint/eslintrc": "^3",
    "@storybook/addon-a11y": "^9.0.9",
    "@storybook/addon-docs": "^9.0.9",
    "@storybook/addon-vitest": "^9.0.9",
    "@storybook/nextjs-vite": "9.0.9",
    "@tailwindcss/postcss": "^4.1.10",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitest/browser": "^3.2.3",
    "@vitest/coverage-v8": "^3.2.3",
    "autoprefixer": "^10.4.21",
    "env-cmd": "^10.1.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.3.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^9.0.9",
    "husky": "^8.0.0",
    "lint-staged": "^16.1.1",
    "playwright": "^1.53.0",
    "postcss": "^8.5.5",
    "prettier": "^3.5.3",
    "storybook": "^9.0.9",
    "tailwindcss": "^4.1.10",
    "tsc-files": "^1.1.4",
    "typescript": "^5",
    "vitest": "^3.2.3"
  },
  "packageManager": "pnpm@10.8.0+sha512.0e82714d1b5b43c74610193cb20734897c1d00de89d0e18420aebc5977fa13d780a9cb05734624e81ebd81cc876cd464794850641c48b9544326b5622ca29971",
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "next lint --dir src",
      "pnpm prettier"
    ],
    "*.{json,md}": [
      "pnpm prettier"
    ]
  },
  "importSort": {
    ".js, .jsx, .es6, .es, .mjs, .ts, .tsx": {
      "parser": "babylon",
      "style": "eslint"
    }
  }
}
